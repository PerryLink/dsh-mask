{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {}
  },
  "include": ["index.mjs", "lib/**/*.mjs", "scripts/**/*.mjs", "test/**/*.mjs", "types.d.ts"]
}
